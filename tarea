engine = create_engine(DATABASE_URL)

class Utiles(Base):
    __tablename__ = "utiles"
    id = Column(Integer, primary_key=True, index=True)
    nombre = Column(String(100))
    cantidad = Column(Integer)
    precio = Column(Float)

Base.metadata.create_all(bind=engine)

app = FastAPI()

class Util(BaseModel):
    id: int
    nombre: str
    cantidad: int
    precio: float

class ListaUtil(BaseModel):
    lista: List[Util]

@app.get("/tarea-7", response_model=List[Util])
def get_utiles(cantidad: Optional[int] = None, precio: Optional[float] = None):
    db = SessionLocal()
    query = db.query(Utiles)

    if cantidad is not None:
        query = query.filter(Utiles.cantidad >= cantidad)
    if precio is not None:
        query = query.filter(Utiles.precio >= precio)

    utiles = query.all()
    db.close()
    return utiles

@app.get("/tarea-7{id}", response_model=Util)
def get_util(id: int):
    db = SessionLocal()
    util = db.query(Utiles).filter(Utiles.id == id).first()
    db.close()
    if util is None:
        raise HTTPException(status_code=404, detail="Util no encontrado")
    return util

@app.post("/tarea-7")
def get_utiles(lista: ListaUtil):
    db = SessionLocal()
    for util in lista.lista:
        new_util = Utiles(**util.dict())
        db.add(new_util)
    return {"success": True}